# Local development uses SQLite.
DATABASE_URL=file:./dev.db

# Vercel production uses PostgreSQL. Set this in Vercel, not in local .env.
ALUMNINEX_DATABASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
